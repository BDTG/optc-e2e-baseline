+def load_all_datasets_chunked(cfg, chunk=800):
+    """
+    Memory-bounded variant of load_all_datasets for large datasets (OpTC H051).
+    
+    Instead of loading ALL train/val/test graphs into RAM at once (which exceeds
+    the 28GB WSL limit for OpTC), we load them in chunks of `chunk` graphs per
+    split, run training/validation/testing on each chunk, then free memory.
+    
+    Returns chunked data handlers that the training loop iterates over.
+    Uses generator pattern: only `chunk` graphs reside in RAM at any time.
+    
+    Since Velox encoder is 'none' (no TGN), full_data is None and we don't
+    need global message concatenation.
+    """
+    import gc
+    from torch_geometric.data import Data
+    
+    def _load_split_chunked(split, chunk_size):
+        """Yields INDIVIDUAL graphs one at a time (lazy), but only keeps
+        `chunk_size` graphs in RAM at once. After each chunk, frees memory.
+        This bounds peak RAM while yielding graphs (not lists) so the
+        training loop `for g in train_data: g.to(device)` works unchanged."""
+        all_files = sorted(os.listdir(os.path.join(
+            cfg.featurization.embed_edges._edge_embeds_dir, split)))
+        buffer = []
+        for f in all_files:
+            filepath = os.path.join(
+                cfg.featurization.embed_edges._edge_embeds_dir, split, f)
+            data = torch.load(filepath, weights_only=False).to("cpu")
+            if hasattr(data, 'msg') and data.msg is not None:
+                data.msg = data.msg.clone()
+            buffer.append(data)
+            if len(buffer) >= chunk_size:
+                buffer = extract_msg_from_data(buffer, cfg)
+                for g in buffer:
+                    yield g
+                buffer = []
+                gc.collect()
+        # Remaining
+        if buffer:
+            buffer = extract_msg_from_data(buffer, cfg)
+            for g in buffer:
+                yield g
+            gc.collect()
+    
+    # Find max_node across all splits (needed for model init) - stream to avoid RAM spike
+    max_node = 0
+    for split in ["train", "val", "test"]:
+        for data_list in _load_split_chunked(split, chunk):
+            for data in data_list:
+                node_max = torch.cat([data.src, data.dst]).max().item()
+                if node_max > max_node:
+                    max_node = node_max
+            del data_list
+            gc.collect()
+    
+    max_node = max_node + 1
+    print(f"Max node in {cfg.dataset.name}: {max_node}")
+    
+    # Return chunked iterators (generators) - training loop consumes one chunk at a time
+    train_chunks = _load_split_chunked("train", chunk)
+    val_chunks = _load_split_chunked("val", chunk)
+    test_chunks = _load_split_chunked("test", chunk)
+    
+    return train_chunks, val_chunks, test_chunks, None, max_node
+
